@startuml sequence-review
title UML, диаграмма последовательности: прогон ревью MR
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
autonumber
participant "Self-hosted\nGitLab" as GL
participant "Прием\nсобытий" as H
participant "Оркестратор" as O
participant "Агенты-\nискатели" as F
participant "Проверяющий\nагент" as V
participant "Сервер\nмодели" as M
participant "Рабочая копия\nрепозитория" as R
participant "Публикатор" as P
database "Журнал\nпрогонов" as DB

GL -> H : вебхук MR (открыт или обновлен)
H -> H : проверить секрет вебхука
H -> DB : создать прогон, если доставки с этим Idempotency-Key не было
break прогон уже есть (повторная доставка)
  H --> GL : 200, повторно не запускать
end
H --> GL : 200, прогон в очереди
H -> O : задание на прогон (через очередь)
O -> GL : дифф от merge-base, SHA коммитов, открытые треды
O -> R : обновить до коммита MR
O -> R : прочитать соглашения
O -> DB : сохранить версию соглашений и конфигурацию модели
O -> O : отобрать правила по путям измененных файлов
loop по агенту на каждую из четырех тем, параллельно
  O -> F : дифф и правила темы
  F -> M : запрос
  M --> F : ответ
  F --> O : замечания: файл, строка, номер правила, текст, доказательство
end
note right of O : ошибка модели у искателя\nобрабатывается так же,\nкак у проверяющего агента
O -> DB : сохранить замечания (статус «найдено»)
O -> O : убрать дубли и совпадения с тредами ревьюеров
loop каждое замечание
  O -> V : замечание и текст правила
  V -> R : прочитать файл, найти вызовы
  V -> M : запрос с кодом и правилом
  M --> V : ответ
  break ошибка модели, лимит времени или невалидный ответ
    V --> O : ошибка
    O -> DB : текущее замечание «не проверено», остальные «снято», прогон «ошибка»
  end
  alt доказательство подтверждено кодом и правило применимо
    V --> O : вердикт «подтверждено»
  else иначе
    V --> O : вердикт «отклонено» с причиной
  end
  O -> DB : сохранить вердикт
end
opt прогон не в статусе «ошибка»
  O -> P : подтвержденные замечания
  loop каждое подтвержденное
    P -> GL : создать тред на строке с номером правила
    alt тред создан
      GL --> P : id треда
      P -> DB : связать тред с вердиктом
    else ошибка API после трех повторов
      P -> DB : замечание «ошибка публикации»
    end
  end
  O -> DB : прогон «завершен»
end
@enduml
